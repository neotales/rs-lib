{
  "variable": {
    "REGISTRY": {
      "default": "registry.example"
    },
    "TAG": {
      "default": "latest"
    }
  },
  "group": {
    "default": {
      "targets": ["app"]
    }
  },
  "target": {
    "app": {
      "args": {
        "VERSION": "1.0.0",
        "DOCKER_DEFAULT": null
      },
      "tags": ["${REGISTRY}/demo:${TAG}"],
      "platforms": ["linux/amd64", "linux/arm64"],
      "target": "runtime",
      "no-cache": true,
      "pull": true
    }
  }
}
